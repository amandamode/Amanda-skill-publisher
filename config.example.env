# ─────────────────────────────────────────────────────────────────────
#  GitHub 发布配置模板
#
#  用法：复制到包外 → 填真实值 → 脚本会自动读取
#      cp config.example.env ~/.workbuddy/secrets/github-publish.env
#      export $(grep -v '^#' ~/.workbuddy/secrets/github-publish.env | xargs)
#
#  ⚠️ 本文件只含占位符，可以公开；填了真实值的副本切勿提交到仓库。
# ─────────────────────────────────────────────────────────────────────

# 【可选】GitHub 用户级 PAT（classic）。
#   优先级：--token-file 参数 > 本文件 / 环境变量 > macOS 钥匙串
#   权限建议：
#     public_repo —— 只推公开仓库，最小权限
#     repo        —— 需要建仓或访问私有仓库时
#   获取：Settings → Developer settings → Personal access tokens → Tokens (classic)
#   也可以不填这个文件，直接跑 scripts/github_device_flow.py 走设备码授权自动写钥匙串。
GITHUB_TOKEN=ghp_your_token_here

# 【必填】GitHub 用户名（仓库归属账号）
GITHUB_OWNER=your-github-login

# 【可选】GitHub API 基地址，默认 https://api.github.com
#   企业代理 / 内网网关 / 私有镜像才需要改
GITHUB_API_BASE=https://api.github.com

# 【可选】默认仓库名前缀（作者开源命名约定：所有开源 skill 仓库统一加 Amanda-）
#   脚本会自动加；仓库名已自带前缀时用 --no-prefix 跳过
GITHUB_REPO_PREFIX=Amanda-

# ── 补充：CI 场景直接注入环境变量即可，不要写进仓库 ──────────────────
#   export GITHUB_TOKEN=ghp_xxx
#   export GITHUB_OWNER=your-login
